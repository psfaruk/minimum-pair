QUOTEX_ACCOUNT_MODE=PRACTICE
QUOTEX_LANG=en

# Token-only auth surface — the ONLY way this app connects to Quotex.
# Paste a session token via the Settings tab (or set it here to skip the
# paste step). There is no email/password login path at all: no
# Cloudflare-guarded login page, no admin passcode, no API keys.
QUOTEX_SESSION_TOKEN=
QUOTEX_SESSION_COOKIES=
QUOTEX_USER_AGENT=

# The watchdog rebuilds the connection when every pair goes silent,
# which is how an expired session token actually presents itself. The
# watchdog reuses the pasted token — there is no password path to fall
# back to.
CONNECTION_WATCHDOG_SECONDS=60
STALE_FEED_SECONDS=300

# Keeping DB_PATH on a mounted volume is what lets the pasted token
# survive a restart without any external API access.
DB_PATH=

# With ALWAYS_SIGNAL on, every pair fires a row on every 60s candle close
# — a lot of pairs adds up to a lot of rows a day, forever, on a billed
# Railway volume. Old graded (WIN/LOSS/DRAW) signals and candles older
# than these windows are pruned automatically; pattern_stats (what the
# engine actually learns weights from) is never touched.
CANDLE_RETENTION_DAYS=30
SIGNAL_RETENTION_DAYS=60
PRUNE_INTERVAL_SECONDS=3600

MIN_CONFIDENCE=0.6
ALWAYS_SIGNAL=1
MIN_CONFIRMATIONS=2
QUALITY_FLOOR=0.5

HOST=127.0.0.1
PORT=8000
