# Quotex credentials — used ONLY for the one-shot email/password login.
# The running app authenticates against the pasted SSID token, not these.
# Leave both blank to use token-only auth (paste a token via the
# Settings tab once the app is running).
QUOTEX_EMAIL=
QUOTEX_PASSWORD=
QUOTEX_ACCOUNT_MODE=PRACTICE
QUOTEX_LANG=en

# Token-only auth surface. Paste a session token via the Settings tab
# (or set it here to skip the paste step) and the app connects live.
# No admin passcode, no API keys, no other auth fields.
QUOTEX_SESSION_TOKEN=
QUOTEX_SESSION_COOKIES=
QUOTEX_USER_AGENT=

# Optional HTTP(S) proxy for the one-shot login only — the way back in
# if Cloudflare has already blocked this deployment's egress IP.
QUOTEX_LOGIN_PROXY=

# The watchdog rebuilds the connection when every pair goes silent,
# which is how an expired session token actually presents itself. The
# watchdog reuses the pasted token; it never falls back to a fresh
# password login on its own.
CONNECTION_WATCHDOG_SECONDS=60
STALE_FEED_SECONDS=300

# Keeping DB_PATH on a mounted volume is what lets the pasted token
# survive a restart without any external API access.
DB_PATH=

MIN_CONFIDENCE=0.6
ALWAYS_SIGNAL=1
MIN_CONFIRMATIONS=2
QUALITY_FLOOR=0.5

HOST=127.0.0.1
PORT=8000
