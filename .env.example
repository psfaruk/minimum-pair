QUOTEX_EMAIL=your_email@example.com
QUOTEX_PASSWORD=your_password
QUOTEX_ACCOUNT_MODE=PRACTICE
QUOTEX_LANG=en

# Optional: paste a session captured from a browser login to skip the
# Cloudflare-guarded login page on every restart. Leave blank to use
# email/password login instead.
QUOTEX_SESSION_TOKEN=
QUOTEX_SESSION_COOKIES=
QUOTEX_USER_AGENT=
QUOTEX_SESSION_FAILURE_THRESHOLD=3

# How long to wait after a failed email/password login before trying
# again. Doubles on each consecutive failure, capped at the max. Keep
# these generous: fast login retries are what get Railway's shared egress
# IPs blocked by Cloudflare.
LOGIN_BACKOFF_BASE_SECONDS=300
LOGIN_BACKOFF_MAX_SECONDS=3600

# Longer waits for the two failures that won't fix themselves: an actual
# Cloudflare block (retrying only extends it) and credentials the broker
# rejected (they stay wrong until you change them — and changing them
# clears the wait immediately).
LOGIN_BACKOFF_CLOUDFLARE_SECONDS=3600
LOGIN_BACKOFF_CLOUDFLARE_MAX_SECONDS=21600
LOGIN_BACKOFF_CREDENTIALS_SECONDS=21600

# Optional HTTP(S) proxy for the login request only — the way back in if
# Cloudflare has already blocked this deployment's egress IP.
QUOTEX_LOGIN_PROXY=

# The watchdog rebuilds the connection when every pair goes silent,
# which is how an expired session token actually presents itself.
CONNECTION_WATCHDOG_SECONDS=60
STALE_FEED_SECONDS=300

# Keeping DB_PATH on a mounted volume is what lets the captured token and
# the login backoff survive a restart without any Railway API access.
DB_PATH=

# Optional: let the app write a freshly captured session back into its own
# Railway variables, so a successful login survives redeploys instead of
# having to be repeated. Needs an account/team token (Railway dashboard ->
# Account Settings -> Tokens); project-scoped tokens are read-only on the
# public API and cannot write variables.
RAILWAY_API_TOKEN=
RAILWAY_TOKEN_TYPE=account
# Railway injects these three automatically in a deployment — only set
# them by hand when running outside Railway.
RAILWAY_PROJECT_ID=
RAILWAY_ENVIRONMENT_ID=
RAILWAY_SERVICE_ID=
RAILWAY_REDEPLOY_AFTER_LOGIN=1
RAILWAY_REDEPLOY_MIN_INTERVAL_SECONDS=900
RAILWAY_API_URL=https://backboard.railway.com/graphql/v2

# Required passcode for POST /api/session (paste a fresh token from the
# Settings tab without redeploying). Must be set to a random secret in
# any publicly-reachable deployment — leaving it blank refuses all
# session-update requests.
ADMIN_TOKEN=

MIN_CONFIDENCE=0.6
ALWAYS_SIGNAL=1
SIGNAL_COOLDOWN_SECONDS=60
MIN_CONFIRMATIONS=2
QUALITY_FLOOR=0.5

HOST=127.0.0.1
PORT=8000
